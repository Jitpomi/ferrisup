[package]
name = "{{project_name}}"
version = "0.1.0"
edition = "2024"
publish = false

[dependencies]
serde = { version = "1.0.229", features = ["derive"] }
serde_json = "1.0.151"
tokio = { version = "1.53", features = ["macros", "net", "rt-multi-thread"] }
anyhow = "1.0"
tracing = "0.1.41"
tracing-subscriber = "0.3.23"

{{#if (eq cloud_provider "aws")}}
# AWS Lambda dependencies
lambda_runtime = "1.3.0"
aws_lambda_events = "1.2.0"
{{/if}}

{{#if (eq cloud_provider "gcp")}}
# GCP Cloud Functions dependencies
hyper = { version = "1.11.1", features = ["server", "http1"] }
hyper-util = { version = "0.1", features = ["tokio"] }
http-body-util = "0.1.5"
bytes = "1.11"
http = "1.5.0"
uuid = { version = "1.26", features = ["v4"] }
{{/if}}

{{#if (eq cloud_provider "azure")}}
# Azure Functions dependencies
hyper = { version = "1.11.1", features = ["server", "http1"] }
hyper-util = { version = "0.1", features = ["tokio"] }
http-body-util = "0.1.5"
bytes = "1.11"
uuid = { version = "1.26", features = ["v4"] }
{{/if}}

{{#if (eq cloud_provider "vercel")}}
# Vercel Functions dependencies
vercel_runtime = "2.4.0"
http = "1.5.0"
http-body-util = "0.1.5"
{{/if}}

{{#if (eq cloud_provider "netlify")}}
# Netlify Functions dependencies
netlify_lambda_http = "0.2.0"
aws_lambda_events = "0.4.0"
{{/if}}

[dev-dependencies]
{{#if (eq cloud_provider "aws")}}
cargo-lambda = "1.9.2"
{{/if}}
http = "1.5.0"
