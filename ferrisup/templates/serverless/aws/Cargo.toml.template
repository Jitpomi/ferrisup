[package]
name = "{{project_name}}"
version = "0.1.0"
edition = "2024"
publish = false

[dependencies]
serde = { version = "1.0.229", features = ["derive"] }
serde_json = "1.0.151"
tokio = { version = "1.53", features = ["macros", "rt-multi-thread"] }
anyhow = "1.0"
tracing = "0.1.41"
tracing-subscriber = "0.3.23"

# AWS Lambda dependencies
lambda_runtime = "1.3.0"
aws_lambda_events = "1.2.0"

[dev-dependencies]
cargo-lambda = "1.9.2"
http = "1.5.0"
