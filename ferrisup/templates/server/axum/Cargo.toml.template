[package]
name = "{{project_name}}"
version = "0.1.0"
edition = "2024"

[dependencies]
axum = "0.8.9"
tokio = { version = "1.53", features = ["full"] }
serde = { version = "1.0.229", features = ["derive"] }
serde_json = "1.0.151"
tower = "0.5.2"
tower-http = { version = "0.7.0", features = ["trace"] }
tracing = "0.1.41"
tracing-subscriber = "0.3.23"

[dev-dependencies]
reqwest = { version = "0.13.4", features = ["json"] }
